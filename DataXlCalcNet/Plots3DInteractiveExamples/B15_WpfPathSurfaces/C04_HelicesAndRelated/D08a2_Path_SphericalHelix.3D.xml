  <Code>double q = 5.0 / 2.0;    // Example 1
//double q = 2.0 / 5.0;    // Example 2
//var q = 1.0 / 5.0;    // Example 3
var R = 1.0;
var k = q / (q + 2);

var x = R * (k * Math.Cos(t) * Math.Cos(k * t) + Math.Sin(t) * Math.Sin(k * t));
var z = R * (k * Math.Sin(t) * Math.Cos(k * t) - Math.Cos(t) * Math.Sin(k * t));
var y = R * Math.Sqrt(1 - k * k) * Math.Cos(k * t);
</Code>
