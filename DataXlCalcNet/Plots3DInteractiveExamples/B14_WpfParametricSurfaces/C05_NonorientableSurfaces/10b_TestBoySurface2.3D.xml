  <Code>var sqrt2 = Math.Sqrt(2);

var cu = Math.Cos(u);
var cv = Math.Cos(v);
var cv2 = cv * cv;
var s2v = Math.Sin(2 * v);
var d = 2 - sqrt2 * Math.Sin(3 * u) * s2v;

var xn = sqrt2 * cv2 * Math.Cos(2 * u) + cu * s2v;
var yn = sqrt2 * cv2 * Math.Sin(2 * u) - Math.Sin(u) * s2v;
var zn = 3 * cv2;

var x = xn / d;
var y = yn / d;
var z = zn / d;
</Code>
