<?xml version="1.0" encoding="utf-8"?>
<WpfGraphicsSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Title>Lemniscate, translation in Z, rotation in Y, resizing in X,Y,Z</Title>
  <Plot3DType1>Translation surface</Plot3DType1>
  <CameraAngleTheta>53</CameraAngleTheta>
  <CameraAnglePhi>111</CameraAnglePhi>
  <CameraRadius>4</CameraRadius>
  <CameraIsOrthographic>false</CameraIsOrthographic>
  <ShowAxes>true</ShowAxes>
  <StyleOfAxes>BackPanel</StyleOfAxes>
  <AxesLabelsBackColor>false</AxesLabelsBackColor>
  <FunctionType />
  <Code>double c = 2.0;
double r = c * 0.5;
phi = (double t) =&gt; r * (Math.Cos(t) / (1 + Math.Sin(t) * Math.Sin(t)));
psi = (double t) =&gt; r * (Math.Sin(t) * Math.Cos(t) / (1 + Math.Sin(t) * Math.Sin(t)));

</Code>
  <Resolution>96</Resolution>
  <Resolution2>0</Resolution2>
  <xmin>Pi / 2</xmin>
  <xmax>5 * Pi / 2</xmax>
  <zmin />
  <zmax />
  <RepeatStart>true</RepeatStart>
  <TransformRepeat>64</TransformRepeat>
  <ReScalingFactor />
  <XRotation />
  <YRotation>-20</YRotation>
  <ZRotation />
  <XTranslation />
  <YTranslation>0.17</YTranslation>
  <ZTranslation />
  <XScale>0.95</XScale>
  <YScale>0.95</YScale>
  <ZScale>0.95</ZScale>
  <XShift>5.0</XShift>
  <Truncate>0</Truncate>
  <LogLogTransform>false</LogLogTransform>
  <KeepRatios>false</KeepRatios>
  <CenteredXY>false</CenteredXY>
  <SameScale>All</SameScale>
  <ComplexType>TRANSLATION</ComplexType>
  <Branchcuts>None</Branchcuts>
  <SurfaceMaterial1>PlainColor</SurfaceMaterial1>
  <SurfaceColorString>-4128832</SurfaceColorString>
  <SurfaceGradient1>None</SurfaceGradient1>
  <SurfaceColorMap1>None</SurfaceColorMap1>
  <SurfaceTexture1>None</SurfaceTexture1>
