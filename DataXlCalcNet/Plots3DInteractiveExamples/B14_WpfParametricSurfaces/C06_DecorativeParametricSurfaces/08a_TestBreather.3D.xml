  <Code>var b = 0.4;
var r = 1 - b * b;
var w = Math.Sqrt(r);
var denom = b * (
    (w * Math.Cosh(b * u)) * (w * Math.Cosh(b * u)) +
    (b * Math.Sin(w * v)) * (b * Math.Sin(w * v)));

var x = -u + (2 * r * Math.Cosh(b * u) * Math.Sinh(b * u)) / denom;
var y = (2 * w * Math.Cosh(b * u) * (-(w * Math.Cos(v) * Math.Cos(w * v)) - Math.Sin(v) * Math.Sin(w * v))) / denom;
var z = (2 * w * Math.Cosh(b * u) * (-(w * Math.Sin(v) * Math.Cos(w * v)) + Math.Cos(v) * Math.Sin(w * v))) / denom;</Code>
