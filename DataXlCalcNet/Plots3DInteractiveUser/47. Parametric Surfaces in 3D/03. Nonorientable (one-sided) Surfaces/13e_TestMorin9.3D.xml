  <Code>var k = 1.2;
var n = 9.0;

var Sqrt2 = Math.Sqrt(2);
var cu = Math.Cos(u);
var su = Math.Sin(u);
var K = cu / (Sqrt2 - k * Math.Sin(2 * u) * Math.Sin(n * v));

var x = K * (2 / (n - 1) * cu * Math.Cos((n - 1) * v) + Sqrt2 * su * Math.Cos(v));
var y = K * (2 / (n - 1) * cu * Math.Sin((n - 1) * v) - Sqrt2 * su * Math.Sin(v));
var z = K * cu;
</Code>
