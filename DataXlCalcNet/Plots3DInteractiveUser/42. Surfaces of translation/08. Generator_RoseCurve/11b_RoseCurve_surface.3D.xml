<?xml version="1.0" encoding="utf-8"?>
<WpfGraphicsSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Title>RoseCurve, translation in Z direction, resizing in Y</Title>
  <Plot3DType1>Translation surface</Plot3DType1>
  <CameraAngleTheta>143</CameraAngleTheta>
  <CameraAnglePhi>136</CameraAnglePhi>
  <CameraRadius>0</CameraRadius>
  <CameraIsOrthographic>false</CameraIsOrthographic>
  <ShowAxes>true</ShowAxes>
  <StyleOfAxes>BackPanel</StyleOfAxes>
  <AxesLabelsBackColor>false</AxesLabelsBackColor>
  <FunctionType />
  <Code>double a = 0.0;
double h = 2.0;
double n = 3.0;
double ca = Math.Cos(a);

phi = (double t) =&gt;  (h * Math.Abs(Math.Cos(n * t)) * ca) * Math.Cos(t);
psi = (double t) =&gt;  (h * Math.Abs(Math.Cos(n * t)) * ca) * Math.Sin(t);


</Code>
  <Resolution>96</Resolution>
  <Resolution2>0</Resolution2>
  <xmin>Pi / 2</xmin>
  <xmax>5 * Pi / 2</xmax>
  <zmin />
  <zmax />
  <RepeatStart>true</RepeatStart>
  <TransformRepeat>8</TransformRepeat>
  <ReScalingFactor />
  <XRotation />
  <YRotation />
  <ZRotation />
  <XTranslation />
  <YTranslation />
  <ZTranslation>0.75</ZTranslation>
  <YScale>0.9</YScale>
  <Truncate>0</Truncate>
  <LogLogTransform>false</LogLogTransform>
  <KeepRatios>false</KeepRatios>
  <CenteredXY>false</CenteredXY>
  <SameScale>None</SameScale>
  <ComplexType>TRANSLATION</ComplexType>
  <Branchcuts>None</Branchcuts>
  <SurfaceMaterial1>PlainColor</SurfaceMaterial1>
  <SurfaceColorString>-4128832</SurfaceColorString>
  <SurfaceGradient1>None</SurfaceGradient1>
  <SurfaceColorMap1>None</SurfaceColorMap1>
  <SurfaceTexture1>None</SurfaceTexture1>
  <SurfaceSmoothing>true</SurfaceSmoothing>
  <Transparency>0</Transparency>
  <BackMaterial1>PlainColor</BackMaterial1>
  <BackColorString>-8000</BackColorString>
  <ShowWireframe>false</ShowWireframe>
  <WireframeThickness>0.01</WireframeThickness>
  <WireframeColorString>Green</WireframeColorString>
  <HighlightVertices>false</HighlightVertices>
  <VerticesThickness>0</VerticesThickness>
  <VerticesColorString>Red</VerticesColorString>
  <HighlightGenerator>true</HighlightGenerator>
  <GeneratorThickness>0.02</GeneratorThickness>
  <GeneratorColorString>Black</GeneratorColorString>
</WpfGraphicsSettings>