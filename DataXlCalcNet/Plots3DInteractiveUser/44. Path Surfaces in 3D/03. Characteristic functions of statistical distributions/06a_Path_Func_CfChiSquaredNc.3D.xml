  <FunctionType />
  <Code>double nu = 10.0;
double lambda1 = 50.0;
Complex i1 = Complex.ImaginaryOne;
Complex fz = Complex.Zero;
fz = Complex.Pow(1 - 2 * i1 * t, -nu / 2);
fz *= Complex.Exp((i1 * t * lambda1) / (1 - 2 * i1 * t));
var y = fz.Real;
var z = -fz.Imaginary;
var x = t;
</Code>
