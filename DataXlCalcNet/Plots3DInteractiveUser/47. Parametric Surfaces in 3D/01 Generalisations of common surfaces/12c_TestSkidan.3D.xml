  <FunctionType />
  <Code>var a = Math.PI / 4.0;
var h = 2.0;
var n = 4.0;

var b = h * Math.Abs(Math.Cos(n * v));
var ca = Math.Cos(a);
var sa = Math.Sin(a);

var x = (u * sa + b * ca) * Math.Cos(v);
var y = (u * sa + b * ca) * Math.Sin(v);
var z = -(u * ca - b * sa);
</Code>
