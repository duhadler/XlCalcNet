Public Function GetCPythonExeDirLocal() As String
	GetCPythonExeDirLocal =&quot;C:\Users\dietrichhadler\Documents\Python38&quot;
End Function


Public Function GetCPythonPathLocal() As String
	Dim PP As String
	PP = GetCPythonExeDirLocal()
	GetCPythonPathLocal = PP + &quot;,&quot; + PP + &quot;\DLLs,&quot; + PP + &quot;\Lib,&quot; + PP + &quot;\Lib\site-packages&quot;
End Function


Sub DemCPythonPath()
	s =  GetCPythonPathLocal()
	Print(s)
End Sub


