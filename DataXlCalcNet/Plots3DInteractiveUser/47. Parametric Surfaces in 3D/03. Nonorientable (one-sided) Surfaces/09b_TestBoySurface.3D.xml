  <Code>var sqrt5 = Math.Sqrt(5);
var wr = Math.Cos(v);
var wi = Math.Sin(v);
Complex w = u * new Complex(wr, wi);
Complex w3 = w * w * w;
Complex w4 = w3 * w;
Complex w6 = w3 * w3;

Complex d = w6 + sqrt5 * w3 - 1;
Complex wa = w * (1 - w4) / d;
Complex wb = w * (1 + w4) / d;
Complex wc = (1 + w6) / d;

var g1 = -1.5 * wa.Imaginary;
var g2 = -1.5 * wb.Real;
var g3 = wc.Imaginary - 0.5;
var l2 = g1 * g1 + g2 * g2 + g3 * g3;

var x = g1 / l2;
var y = -g2 / l2;
var z = g3 / l2;
z = -z;
</Code>
