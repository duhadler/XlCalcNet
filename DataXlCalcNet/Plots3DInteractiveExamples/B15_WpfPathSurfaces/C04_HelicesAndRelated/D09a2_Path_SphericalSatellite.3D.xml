<?xml version="1.0" encoding="utf-8"?>
<WpfGraphicsSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Title>SphericalSatellite</Title>
  <CameraAngleTheta>90</CameraAngleTheta>
  <CameraAnglePhi>100</CameraAnglePhi>
  <CameraRadius>3</CameraRadius>
  <CameraIsOrthographic>false</CameraIsOrthographic>
  <ShowAxes>true</ShowAxes>
  <StyleOfAxes>BackPanel</StyleOfAxes>
  <Plot3DType1>Path surface</Plot3DType1>
  <Code>double R = 1.0;
//double alpha = 1 * Math.PI / 2;  // This corresponds to clelias
double alpha = 3 * Math.PI / 4;
double k = 3.0 / 4.0;
//double k = -Math.Cos(alpha);  // This corresponds to spherical helices

var x = R * (Math.Cos(alpha) * Math.Cos(t) * Math.Cos(k * t) - Math.Sin(t) * Math.Sin(k * t));
var z = R * (Math.Cos(alpha) * Math.Sin(t) * Math.Cos(k * t) + Math.Cos(t) * Math.Sin(k * t));
var y = R * Math.Sin(alpha) * Math.Cos(k * t);
</Code>
  <Resolution>1024</Resolution>
  <Resolution2>16</Resolution2>
  <xmin>0.0</xmin>
  <xmax>8 * Pi</xmax>
  <zmin>0.0</zmin>
  <zmax>0.01</zmax>
  <RepeatStart>true</RepeatStart>
  <PathEvalOrder>SequenceX</PathEvalOrder>
  <FinalRotationOrder>X-Y-Z</FinalRotationOrder>
  <FinalXRotation>90</FinalXRotation>
  <FinalYRotation>0</FinalYRotation>
  <FinalZRotation>0</FinalZRotation>
  <Truncate>0</Truncate>
  <LogLogTransform>false</LogLogTransform>
  <CenteredXY>true</CenteredXY>
  <SameScale>All</SameScale>
  <ComplexType>N/A</ComplexType>
  <Branchcuts>None</Branchcuts>
  <SurfaceMaterial1>Gradient</SurfaceMaterial1>
  <SurfaceColorString>-4128832</SurfaceColorString>
  <SurfaceGradient1>SequenceGradient0</SurfaceGradient1>
  <SurfaceColorMap1>None</SurfaceColorMap1>
  <SurfaceTexture1>None</SurfaceTexture1>
  <SurfaceSmoothing>false</SurfaceSmoothing>
  <Transparency>0</Transparency>
  <BackMaterial1>PlainColor</BackMaterial1>
  <BackColorString>-8000</BackColorString>
  <ShowWireframe>false</ShowWireframe>
  <WireframeThickness>0.01</WireframeThickness>
  <WireframeColorString>Green</WireframeColorString>
  <HighlightVertices>false</HighlightVertices>
  <VerticesThickness>0.01</VerticesThickness>
  <VerticesColorString>Red</VerticesColorString>
  <SolidType>None</SolidType>
  <GeneratorColorString>-16256</GeneratorColorString>
  <BackgroundSolidTransparency>0</BackgroundSolidTransparency>
