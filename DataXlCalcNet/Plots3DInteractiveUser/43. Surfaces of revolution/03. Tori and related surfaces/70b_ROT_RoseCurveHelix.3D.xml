<?xml version="1.0" encoding="utf-8"?>
<WpfGraphicsSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Title>Lemniscate Torus</Title>
  <Plot3DType1>Rotation surface</Plot3DType1>
  <CameraAngleTheta>284</CameraAngleTheta>
  <CameraAnglePhi>95</CameraAnglePhi>
  <CameraRadius>3</CameraRadius>
  <CameraIsOrthographic>false</CameraIsOrthographic>
  <ShowAxes>true</ShowAxes>
  <StyleOfAxes>BackPanel</StyleOfAxes>
  <AxesLabelsBackColor>false</AxesLabelsBackColor>
  <FunctionType>_ROT_RoseCurveTorus</FunctionType>
  <Code>double a = 0.0;
double h = 2.0;
double n = 3.0;
double ca = Math.Cos(a);

double R = 1.5;
double r = 0.275;

phi = (double t) =&gt; R + r*  ((h * Math.Abs(Math.Cos(n * t)) * ca) * Math.Cos(t));
psi = (double t) =&gt;  r*((h * Math.Abs(Math.Cos(n * t)) * ca) * Math.Sin(t));




</Code>
