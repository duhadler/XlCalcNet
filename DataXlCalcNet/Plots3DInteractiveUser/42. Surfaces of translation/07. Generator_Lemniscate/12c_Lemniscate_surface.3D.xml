  <VerticesColorString>Red</VerticesColorString>
  <HighlightGenerator>true</HighlightGenerator>
  <GeneratorThickness>0.04</GeneratorThickness>
  <GeneratorColorString>Black</GeneratorColorString>
</WpfGraphicsSettings>