<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="dlgNavigator" dlg:left="10" dlg:top="10" dlg:width="230" dlg:height="150" dlg:closeable="true" dlg:moveable="true" dlg:title="Navigator for Mpfunlab">
 <dlg:styles>
  <dlg:style dlg:style-id="0" dlg:background-color="0xffffff"/>
 </dlg:styles>
 <dlg:bulletinboard>
  <dlg:text dlg:id="lblLibrary" dlg:tab-index="0" dlg:left="10" dlg:top="10" dlg:width="100" dlg:height="10" dlg:value="Library"/>
  <dlg:text dlg:id="lblSubroutine" dlg:tab-index="2" dlg:left="120" dlg:top="10" dlg:width="100" dlg:height="10" dlg:value="Subroutine"/>
  <dlg:menulist dlg:style-id="0" dlg:id="lboxSubroutine" dlg:tab-index="3" dlg:left="120" dlg:top="20" dlg:width="100" dlg:height="100"/>
  <dlg:button dlg:id="btnCancel" dlg:tab-index="4" dlg:left="190" dlg:top="130" dlg:width="30" dlg:height="14" dlg:value="Cancel" dlg:button-type="cancel" dlg:repeat="50"/>
  <dlg:button dlg:id="btnOK" dlg:tab-index="5" dlg:left="150" dlg:top="130" dlg:width="30" dlg:height="14" dlg:default="true" dlg:value="OK" dlg:button-type="ok"/>
  <dlg:menulist dlg:style-id="0" dlg:id="lboxLibrary" dlg:tab-index="1" dlg:left="10" dlg:top="20" dlg:width="100" dlg:height="100">
   <script:event script:event-name="on-keyup" script:macro-name="vnd.sun.star.script:MpFunlabLocal.dlgNavigatorBasic.LibraryChanged?language=Basic&amp;location=application" script:language="Script"/>
   <script:event script:event-name="on-mouseup" script:macro-name="vnd.sun.star.script:MpFunlabLocal.dlgNavigatorBasic.LibraryChanged?language=Basic&amp;location=application" script:language="Script"/>
  </dlg:menulist>
 </dlg:bulletinboard>
</dlg:window>