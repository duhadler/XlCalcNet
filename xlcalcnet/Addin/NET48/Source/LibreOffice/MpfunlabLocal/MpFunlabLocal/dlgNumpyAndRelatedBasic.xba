                    &quot;binomial&quot;, &quot;geometric&quot;, &quot;hypergeometric&quot;, &quot;logseries&quot;, &quot;multinomial&quot;, &quot;multivariate_hypergeometric&quot;, _
                    &quot;negative_binomial&quot;, &quot;poisson&quot;, &quot;zipf&quot;)
                Case &quot;Continuous random numbers (A-M)&quot;: result = Array( _
                    &quot;beta&quot;, &quot;chisquare&quot;, &quot;dirichlet&quot;, &quot;exponential&quot;, &quot;fisher_f&quot;, &quot;gamma&quot;, &quot;gumbel&quot;, &quot;laplace&quot;, &quot;logistic&quot;, &quot;lognormal&quot;, _
                    &quot;multivariate_normal&quot;, &quot;noncentral_chisquare&quot;, &quot;noncentral_f&quot;, &quot;normal&quot;)
                Case &quot;Continuous random numbers (N-Z)&quot;: result = Array( _
                    &quot;pareto&quot;, &quot;power&quot;, &quot;rayleigh&quot;, _
                    &quot;standard_cauchy&quot;, &quot;standard_exponential&quot;, &quot;standard_gamma&quot;, &quot;standard_normal&quot;, &quot;standard_t&quot;, _
                    &quot;triangular&quot;, &quot;uniform&quot;, &quot;vonmises&quot;, &quot;wald&quot;, &quot;weibull&quot;)
                Case Else: result = Array(&quot;None&quot;)
            End Select
               
        Case Else: result = Array(&quot;None&quot;)
    End Select  &apos; Selector 1
    End If
        
        
        
    If Selector0 = &quot;Special functions&quot; Then
    Select Case Selector1

        Case &quot;Elliptic functions and integrals&quot;
            Select Case Selector2
                Case &quot;Conversions of parameters&quot;: result = Array( _
                    &quot;qfrom&quot;, &quot;qbarfrom&quot;, &quot;mfrom&quot;, &quot;kfrom&quot;, &quot;taufrom&quot;, &quot;efrom&quot;, &quot;gfrom&quot;)
                Case &quot;Legendre elliptic integrals, and related&quot;: result = Array( _
                    &quot;elliptic_k&quot;, &quot;elliptic_e&quot;, &quot;elliptic_pi&quot;, &quot;elliptic_f&quot;, &quot;elliptic_e_inc&quot;, &quot;elliptic_pi_inc&quot;, &quot;elliptic_d&quot;, &quot;jacobi_zeta&quot;, _
                    &quot;heuman_lambda&quot;)
                Case &quot;Carlson symmetric elliptic integrals&quot;: result = Array( _
                    &quot;elliprf&quot;, &quot;elliprg&quot;, &quot;elliprj&quot;, &quot;elliprd&quot;, &quot;elliprc&quot;)
                Case &quot;Jacobi elliptic functions&quot;: result = Array( _
                    &quot;ellipfun&quot;, &quot;jacobi_sn&quot;, &quot;jacobi_cn&quot;, &quot;jacobi_dn&quot;, &quot;jacobi_ns&quot;, &quot;jacobi_nc&quot;, &quot;jacobi_nd&quot;, &quot;jacobi_sc&quot;, &quot;jacobi_sd&quot;, _
                    &quot;jacobi_dc&quot;, &quot;jacobi_ds&quot;, &quot;jacobi_cs&quot;, &quot;jacobi_cd&quot;)
                Case &quot;Weierstrass elliptic functions&quot;: result = Array( _
                    &quot;weierstrass_p&quot;, &quot;weierstrass_p_prime&quot;, &quot;weierstrass_p_inv&quot;, &quot;weierstrass_zeta&quot;, &quot;weierstrass_sigma&quot;)
                Case &quot;Jacobi theta functions and related&quot;: result = Array( _
                    &quot;jtheta&quot;, &quot;dedekind_eta&quot;, &quot;modular_lambda&quot;, &quot;modular_delta&quot;, &quot;kleinj&quot;, &quot;elliptic_roots&quot;, &quot;elliptic_invariants&quot;)
            End Select

        Case &quot;Lerch’s transcendent and related&quot;
            Select Case Selector2
                Case &quot;Overview&quot;: result = Array( _
                    &quot;lerchphi&quot;, &quot;lerch_zeta&quot;)
                Case &quot;Polygamma functions&quot;: result = Array( _
                    &quot;polygamma&quot;, &quot;trigamma&quot;, &quot;digamma&quot;)
                Case &quot;Polylogarithms and related&quot;: result = Array( _
                    &quot;polylog&quot;, &quot;trilog&quot;, &quot;dilog&quot;, &quot;clsin&quot;, &quot;clcos&quot;, &quot;cl2&quot;, &quot;bose_einstein&quot;, &quot;fermi_dirac&quot;, &quot;legendre_chi&quot;, &quot;ti&quot;, &quot;debye&quot;)
                Case &quot;Hurwitz zeta and related&quot;: result = Array( _
                    &quot;hurwitz&quot;, &quot;stieltjes&quot;, &quot;harmonic&quot;, &quot;harmonic2&quot;, &quot;bernoulli&quot;, &quot;bernfrac&quot;, &quot;bernpoly&quot;, &quot;eulernum&quot;, &quot;eulerpoly&quot;, _
                    &quot;lnbarnesg&quot;, &quot;barnesg&quot;, &quot;hyperfac&quot;, &quot;superfac&quot;)
                Case &quot;Riemann zeta and related&quot;: result = Array( _
                    &quot;dirichlet_l&quot;, &quot;zeta&quot;, &quot;zetam1&quot;, &quot;riemann_xi&quot;, &quot;dirichlet_eta&quot;, &quot;dirichlet_etam1&quot;, &quot;dirichlet_etam1&quot;, &quot;dirichlet_lambda&quot;, _
                    &quot;siegelz&quot;, &quot;siegeltheta&quot;, &quot;backlunds&quot;, &quot;grampoint&quot;, &quot;nzeros&quot;, &quot;zetazero&quot;, &quot;secondzeta&quot;)
                Case &quot;Numbertheoretic functions&quot;: result = Array( _
                    &quot;primepi&quot;, &quot;mangoldt&quot;, &quot;riemannr&quot;, &quot;primezeta&quot;, &quot;const_mertens&quot;, &quot;const_twinprime&quot;, &quot;cyclotomic&quot;, _
                    &quot;stirling1&quot;, &quot;stirling2&quot;, &quot;bell&quot;, &quot;polyexp&quot;)
            End Select

        Case &quot;Hypergeometric 0F1 and related&quot;
            Select Case Selector2
                Case &quot;Overview&quot;: result = Array( _
                    &quot;hyp0f1&quot;, &quot;hyp0f1r&quot;)
                Case &quot;Bessel functions&quot;: result = Array( _
                    &quot;besselj&quot;, &quot;bessely&quot;, &quot;besseljzero&quot;, &quot;besselyzero&quot;, &quot;besseli&quot;, &quot;besselk&quot;, &quot;besselj_prime&quot;, &quot;bessely_prime&quot;, _
                    &quot;besseli_prime&quot;, &quot;besselk_prime&quot;, &quot;hankel1&quot;, &quot;hankel2&quot;)
                Case &quot;Spherical Bessel functions&quot;: result = Array( _
                    &quot;sph_bessel_jn&quot;, &quot;sph_bessel_yn&quot;, &quot;sph_bessel_in&quot;, &quot;sph_bessel_kn&quot;, &quot;sph_bessel_jn_prime&quot;, _
                    &quot;sph_bessel_yn_prime&quot;, &quot;sph_hankel_h1&quot;, &quot;sph_hankel_h2&quot;)
                Case &quot;Airy functions&quot;: result = Array( _
                    &quot;airyai&quot;, &quot;airybi&quot;, &quot;airyaizero&quot;, &quot;airybizero&quot;, &quot;airy_aip&quot;, &quot;airy_bip&quot;)
                Case &quot;Kelvin functions&quot;: result = Array( _
                    &quot;kelvinber&quot;, &quot;kelvinbei&quot;, &quot;kelvinker&quot;, &quot;kelvinkei&quot;)
            End Select

        Case &quot;Hypergeometric 1F1 and related&quot;
            Select Case Selector2
                Case &quot;Overview&quot;: result = Array( _
                    &quot;hyp1f1&quot;, &quot;hyp1f1r&quot;, &quot;hyperu&quot;)
                Case &quot;Incomplete gamma&quot;: result = Array( _
                    &quot;gammainc&quot;, &quot;gamma_lower&quot;, &quot;gamma_upper&quot;, &quot;gamma_p&quot;, &quot;gamma_q&quot;, &quot;gamma_tricomi&quot;, &quot;gamma_derivative&quot;)
                Case &quot;Error function and related&quot;: result = Array( _
                    &quot;erf&quot;, &quot;erfc&quot;, &quot;inerfc&quot;, &quot;erfi&quot;, &quot;dawson&quot;, &quot;fresnels&quot;, &quot;fresnelc&quot;, &quot;faddeeva&quot;, &quot;voigt_u&quot;, &quot;voigt_v&quot;, &quot;voigt_h&quot;)
                Case &quot;Exponential integrals and related&quot;: result = Array( _
                    &quot;chi&quot;, &quot;ci&quot;, &quot;e1&quot;, &quot;ei&quot;, &quot;expint&quot;, &quot;li&quot;, &quot;primepi2_upper&quot;, &quot;primepi2_lower&quot;, &quot;shi&quot;, &quot;si&quot;)
                Case &quot;Orthogonal polynomials&quot;: result = Array( _
                    &quot;hermite&quot;, &quot;hermite_he&quot;, &quot;laguerre_l&quot;, &quot;laguerre&quot;)
                Case &quot;Coulomb functions&quot;: result = Array( _
                    &quot;coulombc&quot;, &quot;coulombf&quot;, &quot;coulombg&quot;)
                Case &quot;Whittaker functions&quot;: result = Array( _
                    &quot;whitm&quot;, &quot;whitw&quot;, &quot;Power&quot;)
                Case &quot;Parabolic cylinder functions&quot;: result = Array( _
                    &quot;pcfd&quot;, &quot;pcfu&quot;, &quot;pcfv&quot;, &quot;pcfw&quot;)
            End Select

        Case &quot;Hypergeometric 2F1 and related&quot;
            Select Case Selector2
                Case &quot;Overview&quot;: result = Array( _
                    &quot;hyp2f1&quot;, &quot;hyp2f1r&quot;)
                Case &quot;Orthogonal polynomials&quot;: result = Array( _
                    &quot;chebyt&quot;, &quot;chebyu&quot;, &quot;gegenbauer&quot;, &quot;jacobi&quot;, &quot;legendre&quot;, &quot;legenp&quot;, &quot;legenq&quot;, &quot;spherharm&quot;)
                Case &quot;Incomplete Beta Function&quot;: result = Array( _
                    &quot;betainc&quot;, &quot;ibeta&quot;, &quot;beta3&quot;)
            End Select

        Case &quot;Hypergeometric pFq and related&quot;
            Select Case Selector2
                Case &quot;Generalized hypergeometric&quot;: result = Array( _
                    &quot;hyper&quot;, &quot;hyp2f3&quot;, &quot;hyp3f2&quot;, &quot;hyp2f2&quot;, &quot;hyp2f0&quot;)
                Case &quot;Hypergeometric 1F2 and related&quot;: result = Array( _
                    &quot;hyp1f2&quot;, &quot;hyp1f2r&quot;, &quot;scorergi&quot;, &quot;scorerhi&quot;, &quot;struveh&quot;, &quot;struvel&quot;, &quot;struvek&quot;, &quot;struvem&quot;, &quot;angerj&quot;, _
                    &quot;webere&quot;, &quot;lommels1&quot;, &quot;lommels2&quot;)
            End Select

        Case &quot;Generalizations of various functions&quot;
            Select Case Selector2
                Case &quot;Appell Functions&quot;: result = Array( _
                    &quot;appellf1&quot;, &quot;appellf2&quot;, &quot;appellf3&quot;, &quot;appellf4&quot;)
                Case &quot;Q Functions&quot;: result = Array( _
                    &quot;qp&quot;, &quot;qgamma&quot;, &quot;qfac&quot;, &quot;qhyper&quot;)
                Case &quot;Further generalizations&quot;: result = Array( _
                    &quot;gammaprod&quot;, &quot;hypercomb&quot;, &quot;meijerg&quot;, &quot;bihyper&quot;, &quot;hyper2d&quot;)
            End Select



        Case &quot;Algebra with random variables&quot;
            Select Case Selector2
                Case &quot;Probability density function (pdf)&quot;: result = Array( _
                    &quot;Pdf from the cdf&quot;, &quot;Pdf from the characteristic function&quot;)
                Case &quot;Probability mass function (pmf)&quot;: result = Array( _
                    &quot;Pmf from the cdf&quot;, &quot;Pmf from the characteristic function&quot;, &quot;Pmf from the factorial moments&quot;, &quot;Pmf with asymptotic expansions&quot;)
                Case &quot;Cumulative distribution function (cdf)&quot;: result = Array( _
                    &quot;Cdf from the pdf&quot;, &quot;cdf from the pmf&quot;, &quot;Cdf from the characteristic function&quot;, _
                    &quot;Cdf from the characteristic function (lattice distribution)&quot;, &quot;Cdf from the factorial moments (lattice distributions)&quot;)
                Case &quot;Quantile function (qtf)&quot;: result = Array( _
                    &quot;Qtf from the cdf&quot;, &quot;Qtf from the cgf&quot;, &quot;Qtf from the cumulants&quot;)
                Case &quot;Characteristic function (cf)&quot;: result = Array( _
                    &quot;Cf from the pdf (continuous)&quot;, &quot;Cf from the pdf (lattice)&quot;, &quot;Cf from the qtf&quot;, &quot;Cf from the raw moments&quot;)
                Case &quot;Moment generating function (mgf)&quot;: result = Array( _
                    &quot;Mgf from the pdf (continuous)&quot;, &quot;Mgf from the cf&quot;, &quot;Mgf from the cgf&quot;, &quot;Mgf from the pgf (lattice)&quot;, _
                    &quot;Mgf from the raw moments&quot;)
                Case &quot;Cumulant generating function (cgf)&quot;: result = Array( _
                    &quot;Cgf from the cf&quot;, &quot;Cgf from the mgf&quot;, &quot;Cgf from the pgf (lattice)&quot;, &quot;Cgf from the cumulants&quot;)
                Case &quot;Probability generating function (pgf)&quot;: result = Array( _
                    &quot;Pgf from pmf vector&quot;, &quot;pgf from mgf&quot;)
                Case &quot;Factorial Moments&quot;: result = Array( _
                    &quot;Factorial moments from the raw moment&quot;, &quot;Factorial moments from the cumulants&quot;)
                Case &quot;Raw Moments&quot;: result = Array( _
                    &quot;Raw moments from the pdf&quot;, &quot;Raw moments from the pmf&quot;, &quot;Raw moments from the factorial moments&quot;, _
                    &quot;Raw moments from the central moments&quot;, &quot;Raw moments from the cumulants&quot;, &quot;Raw moments from the mgf&quot;, _
                    &quot;Raw moments from the cf&quot;, &quot;Raw moments from the pgf&quot;)
                Case &quot;Central Moments&quot;: result = Array( _
                    &quot;Central moments from factorial moments&quot;, &quot;Central moments from raw moments&quot;, &quot;Central moments from cumulants&quot;)
                Case &quot;Cumulants&quot;: result = Array( _
                    &quot;Cumulants from the pmf vector&quot;, &quot;Cumulants from the factorial moments&quot;, &quot;Cumulants from the raw moments&quot;, _
                    &quot;Cumulants from the central moments&quot;, &quot;Cumulants from the cgf&quot;)
            End Select



        Case &quot;Inferential Statistics&quot;
            Select Case Selector2
                Case &quot;Basic tests for 1 sample&quot;: result = Array( _
                    &quot;Student&apos;s t-test: test (p-value)&quot;, &quot;Student&apos;s t-test: confidence interval&quot;, &quot;Student&apos;s t-test: power&quot;, &quot;Student&apos;s t-test: samples size&quot;, _
                    &quot;Student&apos;s t-test: effect size&quot;, &quot;Student&apos;s t-test: tolerance interval&quot;, &quot;Student&apos;s t-test: prediction interval&quot;, _
                    &quot;Variance: test (p-value)&quot;, &quot;Variance: confidence interval&quot;, &quot;Variance: power&quot;, &quot;Variance: samples size&quot;)
                Case &quot;Basic tests for 2 independent samples&quot;: result = Array( _
                    &quot;Student&apos;s t-test: test (p-value)&quot;, &quot;Student&apos;s t-test: confidence interval&quot;, &quot;Student&apos;s t-test: power&quot;, &quot;Student&apos;s t-test: samples size&quot;, _
                    &quot;Student&apos;s t-test: effect size&quot;, &quot;Student&apos;s t-test: failure to stratify&quot;, &quot;Student&apos;s t-test: equivalence&quot;, _
                    &quot;F-test (2 variances): test (p-value)&quot;, &quot;F-test (2 variances): confidence interval&quot;, &quot;F-test (2 variances): power&quot;, _
                    &quot;F-test (2 variances): samples size&quot;)
                Case &quot;Basic tests for 2 correlated samples&quot;: result = Array( _
                     &quot;Student&apos;s t test: test (p-value)&quot;, &quot;Student&apos;s t-test: confidence interval&quot;, &quot;Student&apos;s t-test: power&quot;, &quot;Student&apos;s t-test: samples size&quot;, _
                    &quot;Morgan-Pitman-test: test (p-value)&quot;, &quot;Morgan-Pitman-test: confidence interval&quot;, &quot;Morgan-Pitman-test: power&quot;, _
                    &quot;Morgan-Pitman-test: samples size&quot;, _
                    &quot;Pearson&apos;s rho: test (p-value)&quot;, _
                    &quot;Pearson&apos;s rho, Type I: confidence interval&quot;, &quot;Pearson&apos;s rho, Type I: power&quot;, &quot;Pearson&apos;s rho, Type I: samples size&quot;, _
                    &quot;Pearson&apos;s rho, Type II: confidence interval&quot;, &quot;Pearson&apos;s rho, Type II: power&quot;, &quot;Pearson&apos;s rho, Type II: samples size&quot;)
                Case &quot;CR design: Anova, trend tests, Scheffe&quot;: result = Array( _
                  &quot;Anova: test (p-value)&quot;, &quot;Anova: confidence interval&quot;, &quot;Anova: power&quot;, &quot;Anova: samples size&quot;, _
                  &quot;Orthogonal polynomials: test (p-value)&quot;, &quot;Orthogonal polynomials: conf. intv.&quot;, &quot;Orthogonal polynomials: power&quot;, _
                  &quot;Orthogonal polynomials: samples size&quot;, _
                  &quot;Scheffé-test: test (p-value)&quot;, &quot;Scheffé-test: confidence interval&quot;, &quot;Scheffé-test: power&quot;, &quot;Scheffé-test: samples size&quot;)
                Case &quot;CR design: Multiple comparisons of means&quot;: result = Array( _
                    &quot;Tukey-Kramer-test: test (p-value)&quot;, &quot;Tukey-Kramer-test: confidence interval&quot;, &quot;Tukey-Kramer-test: power&quot;, _
                    &quot;Tukey-Kramer-test: samples size&quot;, _
                    &quot;Fisher-Hayter test: test (p-value)&quot;, &quot;REGWQ test: test (p-value)&quot;, &quot;Newman-Keuls test: test (p-value)&quot;, _
                    &quot;Duncan-test: test (p-value)&quot;, _
                    &quot;Dunnett t-test: test (p-value)&quot;, &quot;Dunnett t-test: confidence interval&quot;, &quot;Dunnett t-test: power&quot;, &quot;Dunnett t-test: samples size&quot;, _
                    &quot;Marcus t-test: test (p-value)&quot;, &quot;Hsu t-test: test (p-value)&quot;)
                Case &quot;RB design: Anova, trend tests, Scheffe&quot;: result = Array( _
                  &quot;Anova: test (p-value)&quot;, &quot;Anova: confidence interval&quot;, &quot;Anova: power&quot;, &quot;Anova: samples size&quot;, _
                  &quot;Orthogonal polynomials: test (p-value)&quot;, &quot;Orthogonal polynomials: conf. intv.&quot;, &quot;Orthogonal polynomials: power&quot;, _
                  &quot;Orthogonal polynomials: samples size&quot;, _
                  &quot;Scheffé-test: test (p-value)&quot;, &quot;Scheffé-test: confidence interval&quot;, &quot;Scheffé-test: power&quot;, &quot;Scheffé-test: samples size&quot;)
                Case &quot;RB design: Multiple comparisons of means&quot;: result = Array( _
                    &quot;Tukey-Kramer-test: test (p-value)&quot;, &quot;Tukey-Kramer-test: confidence interval&quot;, &quot;Tukey-Kramer-test: power&quot;, _
                    &quot;Tukey-Kramer-test: samples size&quot;, &quot;Fisher-Hayter test: test (p-value)&quot;, _
                    &quot;Dunnett t-test: test (p-value)&quot;, &quot;Dunnett t-test: confidence interval&quot;, &quot;Dunnett t-test: power&quot;, &quot;Dunnett t-test: samples size&quot;, _
                    &quot;Marcus t-test: test (p-value)&quot;, &quot;Hsu t-test: test (p-value)&quot;)
                Case &quot;Tests for proportians, 1 or 2 samples&quot;: result = Array( _
                    &quot;Sign test: p-value&quot;, &quot;Sign test: confidence interval&quot;, &quot;Sign test: power&quot;, &quot;Sign test: sample size&quot;, _
                    &quot;Brown-Mood test: p-value&quot;, &quot;Brown-Mood test: confidence interval&quot;, &quot;Brown-Mood test: power&quot;, _
                    &quot;Brown-Mood test: sample size&quot;, &quot;&quot;)
                Case &quot;Rank tests, 1 or 2 samples&quot;: result = Array( _
                    &quot;Wilcoxon signed rank test: p-value&quot;, &quot;Wilcoxon signed rank test:: confidence interval&quot;, &quot;Wilcoxon signed rank test: power&quot;, _
                    &quot;Wilcoxon signed rank test: sample size&quot;, _
                    &quot;Mann-Whitney test: p-value&quot;, &quot;Mann-Whitney test: confidence interval&quot;, _
                    &quot;Mann-Whitney test: power (Lehmann)&quot;, &quot;Mann-Whitney test: sample size (Lehmann)&quot;, _
                    &quot;Mann-Whitney test: power (Milton)&quot;, &quot;Mann-Whitney test: sample size (Milton)&quot;, _
                    &quot;Siegel-Tukey test: p-value&quot;, &quot;Siegel-Tukey test: confidence interval&quot;, &quot;Spearman&apos;s test: p-value&quot;, _
                    &quot;Kendall&apos;s tau: p-value&quot;, &quot;Kendall&apos;s tau: confidence interval&quot;, _
                    &quot;Theill&apos;s test: p-value&quot;, &quot;Theill&apos;s test: confidence interval&quot;)
                Case &quot;Rank tests, k samples&quot;: result = Array( _
                    &quot;J.-Terpsta-test: p-value&quot;, &quot;J.-Terpsta-test: confidence interval&quot;, _
                    &quot;J.-Terpsta-test: power (Shorack)&quot;, &quot;J.-Terpsta-test: sample size (Shorack)&quot;, _
                    &quot;J.-Terpsta-test: power (Milton)&quot;, &quot;J.-Terpsta-test: sample size (Milton)&quot;, _
                    &quot;Generalized Page L test: p-value&quot;, &quot;Generalized Page L test: power&quot;, &quot;Generalized Page L test: sample size&quot;, _
                    &quot;Generalized Quade L test: p-value&quot;, &quot;Kruskal-Wallis’ H: p-value&quot;, &quot;Cochran’s S: p-value&quot;, _
                    &quot;Friedman’s S: p-value&quot;, &quot;Quade&apos;s S: p-value&quot;)
                Case &quot;Multivariate tests, part 1&quot;: result = Array( _
                    &quot;Multiple linear regression: p-value&quot;, &quot;Mult. lin. regression: confidence interval&quot;, _
                    &quot;Mult. lin. regression Type I: power&quot;, &quot;Mult. lin. regression Type I: sample size&quot;, _
                    &quot;Mult. lin. regression Type II: power&quot;, &quot;Mult. lin. regression Type II: sample size&quot;, _
                    &quot;Hotelling&apos;s T2, 1 sample: test (p-value)&quot;, &quot;Hotelling&apos;s T2, 1 sample: power&quot;, &quot;Hotelling&apos;s T2, 1 sample: samples size&quot;, _
                    &quot;Hotelling&apos;s T2, 2 samples: test (p-value)&quot;, &quot;Hotelling&apos;s T2, 2 samples: power&quot;, &quot;Hotelling&apos;s T2, 2 samples: samples size&quot;)
                Case &quot;Multivariate tests, part 2&quot;: result = Array( _
                    &quot;Manova: p-value&quot;, &quot;Canonical correlation: p-value&quot;, &quot;2 covariance matrices: p-value&quot;, _
                    &quot;Manova: power&quot;, &quot;Manova: sample size&quot;, _
                    &quot;Canonical correlation: power&quot;, &quot;Canonical correlation: sample size&quot;, _
                    &quot;Test for a given covariance matrix: p-value&quot;, &quot;Wilk&apos;s test for no correlation: p-value&quot;, _
                    &quot;Mauchley&apos;s test for sphericity: p-value&quot;, &quot;Box test for equal cov. matrices: p-value&quot;, _
                    &quot;Box test for same mvn distribution: p-value&quot;)
            End Select
        Case Else: result = Array(&quot;None&quot;)
    End Select  &apos; Selector 1
    End If
    
    
     
    If Selector0 = &quot;Statistical distributions&quot; Then
        If (Selector1 = &quot;Elementary discrete (lattice)&quot;) Or (Selector1 = &quot;Discrete, related to rank tests&quot;) _
            Or (Selector1 = &quot;Discrete, non-lattice&quot;) Then
            result = Array(&quot;Probability mass function&quot;, &quot;Cumulative distribution function&quot;, &quot;Survival function&quot;, &quot;Quantile function&quot;, _
            &quot;Inverse Survival function&quot;, &quot;Probability generating function&quot;, _
            &quot;Characteristic function&quot;, &quot;Moment generating function&quot;, &quot;Cumulant generating function&quot;, _
            &quot;Raw moments&quot;, &quot;Central moments&quot;, &quot;Cumulants&quot;, &quot;Entropy&quot;, &quot;Log(pmf)&quot;, &quot;Pmf vector&quot;)
        Else
            result = Array(&quot;Probability density function&quot;, &quot;Cumulative distribution function&quot;, &quot;Survival function&quot;, &quot;Quantile function&quot;, _
            &quot;Inverse Survival function&quot;, &quot;Probability sparsity function&quot;, &quot;Hazard function&quot;, &quot;Cumulative Hazard Function&quot;, _
            &quot;Differerential entropy&quot;, &quot;Negative loglikelihood function&quot;, _
            &quot;Characteristic function&quot;, &quot;Moment generating function&quot;, &quot;Cumulant generating function&quot;, _
            &quot;Raw moments&quot;, &quot;Central moments&quot;, &quot;Cumulants&quot;)
        End If
    End If


    MenuNumpy3 = result
End Function






</script:module>