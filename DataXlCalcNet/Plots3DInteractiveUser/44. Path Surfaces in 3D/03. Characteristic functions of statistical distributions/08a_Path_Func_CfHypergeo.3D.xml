  <Code>int N = 50;
int K = 16;
int n1 = 12;
Complex i1 = Complex.ImaginaryOne;
FCplxT fz = FCplx.Zero();
fz = FCplxFlint.Hypgeom2F1(-n1, -K, N - K - n1 + 1, MathC53.Exp(i1 * t));
fz = fz * Math53.Binomial(N - K, n1) / Math53.Binomial(N, n1);
var x = fz.Real.d;
var y = -fz.Imag.d;
var z = t;
</Code>
