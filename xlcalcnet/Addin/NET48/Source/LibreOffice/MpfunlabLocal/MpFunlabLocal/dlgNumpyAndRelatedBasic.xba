<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="dlgNumpyAndRelatedBasic" script:language="StarBasic" script:moduleType="normal">
&apos;********************************* Beginning of internal dialog routines *****************************************************

Private dlgNumpy1
Private LastNumpyPartPos As Integer
Private LastNumpyCategoryPos As Integer
Private LastNumpySubCategoryPos As Integer
Private LastNumpyFunctionPos As Integer


Sub ShowNumpyDialog()
    With GlobalScope.Basiclibraries
       If Not .IsLibraryLoaded(&quot;Tools&quot;) Then .LoadLibrary(&quot;Tools&quot;)
    End With
   dlgNumpy1 = ModuleControls.LoadDialog(&quot;MpFunlabLocal&quot;, &quot;dlgNumpyAndRelated&quot;)
	dlgNumpy1.setPosSize(300, 300, 0, 0, 3)
    lboxNumpyPart =dlgNumpy1.GetControl(&quot;lboxNumpyPart&quot;)
    lboxNumpyPart.addItems(MenuNumpy0(), 0) 
    lboxNumpyPart.selectItemPos(0, True)
    Selector0 =  lboxNumpyPart.getSelectedItem()     
    LastNumpyPartPos = 0
    
    lboxNumpyCategory =dlgNumpy1.GetControl(&quot;lboxNumpyCategory&quot;)
    lboxNumpyCategory.addItems(MenuNumpy1(Selector0), 0) 
    lboxNumpyCategory.selectItemPos(0, True)
    Selector1 =  lboxNumpyCategory.getSelectedItem()   
    LastNumpyCategoryPos = 0
    
    lboxNumpySubCategory =dlgNumpy1.GetControl(&quot;lboxNumpySubCategory&quot;)
    lboxNumpySubCategory.addItems(MenuNumpy2(Selector0, Selector1), 0) 
    lboxNumpySubCategory.selectItemPos(0, True)
    Selector2 =  lboxNumpySubCategory.getSelectedItem() 
    LastNumpySubCategoryPos = 0
    
    lboxNumpyFunction =dlgNumpy1.GetControl(&quot;lboxNumpyFunction&quot;)
    lboxNumpyFunction.addItems(MenuNumpy3(Selector0, Selector1, Selector2), 0) 
    lboxNumpyFunction.selectItemPos(0, True)
    Selector3 =  lboxNumpyFunction.getSelectedItem() 
    LastNumpyFunctionPos = 0
    
	SetExamplePyCode( Selector0, Selector1, Selector2,Selector3)
    dlgNumpy1.Execute()   
End Sub


Sub SetExamplePyCode( Selector0 As String, Selector1 As String, Selector2 As String,Selector3 As String)
    tbNumpyPythonScript =dlgNumpy1.GetControl(&quot;tbNumpyPythonScript&quot;)
    PyCode = &quot;# Example for: &quot; + Selector0 +&quot; | &quot; + Selector1 + &quot; | &quot;   + Selector2 +&quot; | &quot;   + Selector3 + &quot;:&quot;  + Chr(10) 
    PyCode = PyCode + &quot;temp = 0 $n for i in range(14): $n$t temp += i $n result = 2 * temp&quot;
	tbNumpyPythonScript.setText(PyCode)
	
End Sub


Sub NumpyPartChanged()
	lboxNumpyPart =dlgNumpy1.GetControl(&quot;lboxNumpyPart&quot;)
	CurrentPos = lboxNumpyPart.getSelectedItemPos()
	If (LastNumpyPartPos &lt;&gt; CurrentPos) Then
		LastNumpyPartPos  = CurrentPos
		Selector0 =  lboxNumpyPart.getSelectedItem()
		
	    lboxNumpyCategory =dlgNumpy1.GetControl(&quot;lboxNumpyCategory&quot;) 
	    lboxNumpyCategory.removeItems(0, lboxNumpyCategory.getItemCount())
	    lboxNumpyCategory.addItems(MenuNumpy1(Selector0), 0) 
	    lboxNumpyCategory.selectItemPos(0, True)
		Selector1 =  lboxNumpyCategory.getSelectedItem()	    
	    LastNumpyCategoryPos = 0
			
	    lboxNumpySubCategory =dlgNumpy1.GetControl(&quot;lboxNumpySubCategory&quot;) 
	    lboxNumpySubCategory.removeItems(0, lboxNumpySubCategory.getItemCount())
	    lboxNumpySubCategory.addItems(MenuNumpy2(Selector0, Selector1), 0) 
	    lboxNumpySubCategory.selectItemPos(0, True)
	    Selector2 =  lboxNumpySubCategory.getSelectedItem()	 	    
	    LastNumpySubCategoryPos = 0
	    
	    lboxNumpyFunction =dlgNumpy1.GetControl(&quot;lboxNumpyFunction&quot;)
	    Selector2 =  lboxNumpySubCategory.getSelectedItem() 
	    lboxNumpyFunction.removeItems(0, lboxNumpyFunction.getItemCount())
	    lboxNumpyFunction.addItems(MenuNumpy3(Selector0, Selector1, Selector2), 0) 
	    lboxNumpyFunction.selectItemPos(0, True)
	    LastNumpyFunctionPos = 0		
	    Selector3 =  lboxNumpyFunction.getSelectedItem()
	    SetExamplePyCode( Selector0, Selector1, Selector2,Selector3)	  	    
	End If
End Sub



Sub NumpyCategoryChanged()
	lboxNumpyPart =dlgNumpy1.GetControl(&quot;lboxNumpyPart&quot;)
	lboxNumpyCategory =dlgNumpy1.GetControl(&quot;lboxNumpyCategory&quot;)	
	CurrentPos = lboxNumpyCategory.getSelectedItemPos()
	Selector0 = &quot;Numpy and related&quot;
	If (LastNumpyCategoryPos &lt;&gt; CurrentPos) Then
		LastNumpyCategoryPos  = CurrentPos
		Selector0 =  lboxNumpyPart.getSelectedItem()		
		Selector1 =  lboxNumpyCategory.getSelectedItem()
		
	    lboxNumpySubCategory =dlgNumpy1.GetControl(&quot;lboxNumpySubCategory&quot;) 
	    lboxNumpySubCategory.removeItems(0, lboxNumpySubCategory.getItemCount())
	    lboxNumpySubCategory.addItems(MenuNumpy2(Selector0, Selector1), 0) 
	    lboxNumpySubCategory.selectItemPos(0, True)
	    Selector2 =  lboxNumpySubCategory.getSelectedItem()	    
	    LastNumpySubCategoryPos = 0
	    
	    lboxNumpyFunction =dlgNumpy1.GetControl(&quot;lboxNumpyFunction&quot;)
	    lboxNumpyFunction.removeItems(0, lboxNumpyFunction.getItemCount())
	    lboxNumpyFunction.addItems(MenuNumpy3(Selector0, Selector1, Selector2), 0) 
	    lboxNumpyFunction.selectItemPos(0, True)
	    LastNumpyFunctionPos = 0			
	    Selector3 =  lboxNumpyFunction.getSelectedItem()
	    SetExamplePyCode( Selector0, Selector1, Selector2,Selector3)	    
	End If
End Sub


Sub NumpySubCategoryChanged()
	lboxNumpyPart =dlgNumpy1.GetControl(&quot;lboxNumpyPart&quot;)
	lboxNumpySubCategory =dlgNumpy1.GetControl(&quot;lboxNumpySubCategory&quot;)
	CurrentPos = lboxNumpySubCategory.getSelectedItemPos()
	If (LastNumpySubCategoryPos &lt;&gt; CurrentPos) Then
		LastNumpySubCategoryPos  = CurrentPos
		lboxNumpyCategory =dlgNumpy1.GetControl(&quot;lboxNumpyCategory&quot;)
		Selector0 =  lboxNumpyPart.getSelectedItem()		
		Selector1 =  lboxNumpyCategory.getSelectedItem()
		Selector2 =  lboxNumpySubCategory.getSelectedItem()
		lboxNumpyFunction =dlgNumpy1.GetControl(&quot;lboxNumpyFunction&quot;)
	    lboxNumpyFunction.removeItems(0, lboxNumpyFunction.getItemCount())
	    lboxNumpyFunction.addItems(MenuNumpy3(Selector0, Selector1, Selector2), 0) 
	    lboxNumpyFunction.selectItemPos(0, True)
	    LastNumpyFunctionPos = 0
	    Selector3 =  lboxNumpyFunction.getSelectedItem()
	    SetExamplePyCode( Selector0, Selector1, Selector2,Selector3)
	End If
End Sub






Sub NumpyFunctionChanged()
	lboxNumpyPart =dlgNumpy1.GetControl(&quot;lboxNumpyPart&quot;)
	Selector0 =  lboxNumpyPart.getSelectedItem()
    lboxNumpyCategory =dlgNumpy1.GetControl(&quot;lboxNumpyCategory&quot;) 
	Selector1 =  lboxNumpyCategory.getSelectedItem()	    			    
    lboxNumpySubCategory =dlgNumpy1.GetControl(&quot;lboxNumpySubCategory&quot;)
    Selector2 =  lboxNumpySubCategory.getSelectedItem() 
	lboxNumpyFunction =dlgNumpy1.GetControl(&quot;lboxNumpyFunction&quot;)
	Selector3 =  lboxNumpyFunction.getSelectedItem() 
	CurrentPos = Selector3
	If (LastNumpyFunctionPos &lt;&gt; CurrentPos) Then
		LastNumpyFunctionPos  = CurrentPos
		SetExamplePyCode( Selector0, Selector1, Selector2,Selector3)
	End If
End Sub



Sub NumpyRunButton()
	tbNumpyPythonScript =dlgNumpy1.GetControl(&quot;tbNumpyPythonScript&quot;)
	PyCode = tbNumpyPythonScript.getText()
	fa = createUnoService(&quot;com.sun.star.sheet.FunctionAccess&quot;)  
	ResultArray = fa.callFunction(&quot;APY0&quot;, Array(PyCode))
	Result = ResultArray(0)(0)
	lblResult =dlgNumpy1.GetControl(&quot;lblResult&quot;)	
	lblResult.setText(Str(Result))
End Sub


Sub NumpyInsertButton()
	ActiveCell = ThisComponent.CurrentSelection 
	If NOT ActiveCell.SupportsService(&quot;com.sun.star.sheet.SheetCell&quot;) Then 
		Exit Sub 
	Else		
		tbNumpyPythonScript =dlgNumpy1.GetControl(&quot;tbNumpyPythonScript&quot;)
		PyCode = tbNumpyPythonScript.getText()		
		FormulaFull = &quot;=com.duhadler.release.mpfunlab.python.mpfunlabimpl.apy0(&quot; &amp; &quot;&quot;&quot;&quot; &amp; PyCode &amp; &quot;&quot;&quot;&quot; &amp; &quot;)&quot;
		dlgNumpy1.endExecute()
		ActiveCell.setFormula(FormulaFull)
	End If 
End Sub



Sub NumpyHelpButton()
	&apos;Print(&quot;In NumpyHelpButton&quot;)
    site = &quot;file:///C:/Users/dietrichhadler/Documents/Docs/mpfunlab/html/&quot;
    topic = &quot;045_Numerical_Calculus_mpmath/20_mpmath_numerical_calculus.html#numerical-integration&quot;
    url =  site &amp; topic
    Code = &quot;import webbrowser $n webbrowser.open(&quot; &amp; &quot;&quot;&quot;&quot; &amp; url &amp; &quot;&quot;&quot;&quot; &amp; &quot;)  $n  result = 0&quot;
    &apos;Print Code
	fa = createUnoService(&quot;com.sun.star.sheet.FunctionAccess&quot;)  
	ResultArray = fa.callFunction(&quot;APY0&quot;, Array(Code))
End Sub





&apos;********************************* End of internal dialog routines *****************************************************




Public Function MenuNumpy0() As Variant
    MenuNumpy0 = Array(&quot;Numpy and related&quot;, &quot;Special functions&quot;, &quot;Statistical distributions&quot;, &quot;CPython built-in functions&quot;, _
        &quot;R functions, called from CPython&quot;)
End Function




Public Function MenuNumpy1(Selector0 As String) As Variant
    result = Array(&quot;None&quot;)

    If Selector0 = &quot;Numpy and related&quot; Then
    result = Array( _
        &quot;Array Creation&quot;, &quot;Array manipulation&quot;, &quot;Record Array&quot;, &quot;Sorting and selecting&quot;, _
        &quot;Descriptive Statistics&quot;, &quot;Vectorized math&quot;, &quot;Elementary functions&quot;, &quot;Real functions and their inverses&quot;, _
        &quot;Linear Algebra&quot;, &quot;Polynomials&quot;, &quot;Numerical Calculus&quot;, &quot;Random numbers&quot;)
    End If
    
    If Selector0 = &quot;Special functions&quot; Then
        result = Array( _
         &quot;Elliptic functions and integrals&quot;, &quot;Lerch’s transcendent and related&quot;, &quot;Hypergeometric 0F1 and related&quot;, _
         &quot;Hypergeometric 1F1 and related&quot;, &quot;Hypergeometric 2F1 and related&quot;, &quot;Hypergeometric pFq and related&quot;, _
         &quot;Generalizations of various functions&quot;, &quot;Algebra with random variables&quot;, &quot;Inferential Statistics&quot;)
    End If
      
    If Selector0 = &quot;Statistical distributions&quot; Then
        result = Array( _
            &quot;Based on elementary functions (A-K)&quot;, &quot;Based on elementary functions (L-Z)&quot;, &quot;Based on the error function&quot;, _
            &quot;Based on incomplete gamma&quot;, &quot;Based on incomplete beta&quot;, &quot;Noncentral  (continuous)&quot;, &quot;Multiple comparisons of means&quot;, _
            &quot;Multivariate statistical analysis&quot;, &quot;Miscellaneous (continuous)&quot;, &quot;Elementary discrete (lattice)&quot;, &quot;Discrete, related to rank tests&quot;, _
            &quot;Discrete, non-lattice&quot;)
    End If
       

       
    MenuNumpy1 = result
End Function



Public Function MenuNumpy2(Selector0 As String, Selector1 As String) As Variant
    result = Array(&quot;None&quot;)
    
    If Selector0 = &quot;Numpy and related&quot; Then
    Select Case Selector1
        Case &quot;Array Creation&quot;: result = Array( _
            &quot;From shape or value&quot;, &quot;From existing data&quot;, &quot;Numerical ranges&quot;, &quot;Building matrices&quot;, &quot;As masked array&quot;)
        Case &quot;Array manipulation&quot;: result = Array( _
            &quot;Array shape&quot;, &quot;Transpose-like operations&quot;, &quot;Changing number of dimensions&quot;, _
            &quot;Joining arrays&quot;, &quot;Splitting arrays&quot;, &quot;Adding and removing elements&quot;, &quot;Rearranging elements&quot;, &quot;Indexing-like operations&quot;, _
            &quot;Inserting data into arrays&quot;)
       Case &quot;Record Array&quot;: result = Array( _
        &quot;Create&quot;, &quot;Attributes&quot;, &quot;Methods (A-C)&quot;, &quot;Methods (D-R)&quot;, &quot;Methods (S-Z)&quot;)
        Case &quot;Sorting and selecting&quot;: result = Array( _
            &quot;Sorting&quot;, &quot;Searching&quot;, &quot;Counting&quot;)
        Case &quot;Descriptive Statistics&quot;: result = Array( _
            &quot;Order statistics&quot;, &quot;Averages and variances&quot;, &quot;Correlating&quot;, &quot;Histograms&quot;)
        Case &quot;Vectorized math&quot;: result = Array( _
            &quot;Rounding&quot;, &quot;Sums, products, differences&quot;, &quot;Floating point routines&quot;, _
            &quot;Rational routines&quot;, &quot;Arithmetic operations&quot;, &quot;Handling complex numbers&quot;, &quot;Extrema Finding&quot;, &quot;Miscellaneous&quot;)
        Case &quot;Elementary functions&quot;: result = Array( _
            &quot;Exponential and related&quot;, &quot;Logarithms and related&quot;, &quot;Square, roots and power&quot;, &quot;Trigonometric and related&quot;, _
            &quot;Hyperbolic&quot;, &quot;Inverse trigonometric&quot;, &quot;Inverse hyperbolic&quot;, &quot;Factorials and related&quot;, &quot;Gamma function and related&quot;)
        Case &quot;Real functions and their inverses&quot;: result = Array( _
            &quot;Error functions&quot;, &quot;Incomplete gamma functions&quot;, &quot;Incomplete beta functions&quot;)
        Case &quot;Linear Algebra&quot;: result = Array( _
            &quot;Matrix and vector products&quot;, &quot;Decompositions&quot;, &quot;Matrix eigenvalues&quot;, _
            &quot;Norms and other numbers&quot;, &quot;Solving equations and inverting matrices&quot;)
        Case &quot;Polynomials&quot;: result = Array( _
            &quot;Power Series, part 1&quot;, &quot;Power Series, part 2&quot;, &quot;Chebyshev Series, part 1&quot;, _
            &quot;Chebyshev Series, part 2&quot;, &quot;Hermite Series, Physicists, part 1&quot;, &quot;Hermite Series, Physicists, part 2&quot;, _
            &quot;Hermite Series, Probabilists, part 1&quot;, &quot;Hermite Series, Probabilists, part 2&quot;, &quot;Laguerre Series, part 1&quot;, &quot;Laguerre Series, part 2&quot;, _
            &quot;Legendre Series, part 1&quot;, &quot;Legendre Series, part 2&quot;)
        Case &quot;Numerical Calculus&quot;: result = Array( _
            &quot;Polynomials&quot;, &quot;Rootfinder&quot;, &quot;Sums, products, limits and extrapolation&quot;, _
            &quot;Numerical differentiation and ODEs&quot;, &quot;Numerical integration&quot;, &quot;Numerical inverse Laplace transform&quot;, _
            &quot;Asymptotic expansions&quot;, &quot;Function approximation&quot;, &quot;Number identification&quot;)
        Case &quot;Random numbers&quot;: result = Array( _
            &quot;General&quot;, &quot;Discrete random numbers&quot;, &quot;Continuous random numbers (A-M)&quot;, &quot;Continuous random numbers (N-Z)&quot;)
        Case Else: result = Array(&quot;None&quot;)
    End Select
    End If
    
    If Selector0 = &quot;Special functions&quot; Then
    Select Case Selector1
        Case &quot;Elliptic functions and integrals&quot;: result = Array( _
            &quot;Conversions of parameters&quot;, &quot;Legendre elliptic integrals, and related&quot;, &quot;Carlson symmetric elliptic integrals&quot;, _
            &quot;Jacobi elliptic functions&quot;, &quot;Weierstrass elliptic functions&quot;, &quot;Jacobi theta functions and related&quot;)
        Case &quot;Lerch’s transcendent and related&quot;: result = Array( _
            &quot;Overview&quot;, &quot;Polygamma functions&quot;, &quot;Polylogarithms and related&quot;, &quot;Hurwitz zeta and related&quot;, _
            &quot;Riemann zeta and related&quot;, &quot;Numbertheoretic functions&quot;)
        Case &quot;Hypergeometric 0F1 and related&quot;: result = Array( _
            &quot;Overview&quot;, &quot;Bessel functions&quot;, &quot;Spherical Bessel functions&quot;, &quot;Airy functions&quot;, &quot;Kelvin functions&quot;)
        Case &quot;Hypergeometric 1F1 and related&quot;: result = Array( _
            &quot;Overview&quot;, &quot;Incomplete gamma&quot;, &quot;Error function and related&quot;, &quot;Exponential integrals and related&quot;, &quot;Orthogonal polynomials&quot;, _
            &quot;Coulomb functions&quot;, &quot;Whittaker functions&quot;, &quot;Parabolic cylinder functions&quot;)
        Case &quot;Hypergeometric 2F1 and related&quot;: result = Array( _
            &quot;Overview&quot;, &quot;Orthogonal polynomials&quot;, &quot;Incomplete Beta Function&quot;)
        Case &quot;Hypergeometric pFq and related&quot;: result = Array( _
            &quot;Generalized hypergeometric&quot;, &quot;Hypergeometric 1F2 and related&quot;)
        Case &quot;Generalizations of various functions&quot;: result = Array( _
            &quot;Appell Functions&quot;, &quot;Q Functions&quot;, &quot;Further generalizations&quot;)
            
        Case &quot;Algebra with random variables&quot;: result = Array( _
            &quot;Probability density function (pdf)&quot;, &quot;Probability mass function (pmf)&quot;, &quot;Cumulative distribution function (cdf)&quot;, _
            &quot;Quantile function (qtf)&quot;, &quot;Characteristic function (cf)&quot;, _
            &quot;Moment generating function (mgf)&quot;, &quot;Cumulant generating function (cgf)&quot;, _
            &quot;Probability generating function (pgf)&quot;, &quot;Factorial Moments&quot;, _
            &quot;Raw Moments&quot;, &quot;Central Moments&quot;, &quot;Cumulants&quot;)
                       
        Case &quot;Inferential Statistics&quot;: result = Array( _
            &quot;Basic tests for 1 sample&quot;, &quot;Basic tests for 2 independent samples&quot;, &quot;Basic tests for 2 correlated samples&quot;, _
            &quot;CR design: Anova, trend tests, Scheffe&quot;, &quot;CR design: Multiple comparisons of means&quot;, _
            &quot;RB design: Anova, trend tests, Scheffe&quot;, &quot;RB design: Multiple comparisons of means&quot;, _
            &quot;Tests for proportians, 1 or 2 samples&quot;, &quot;Rank tests, 1 or 2 samples&quot;, _
            &quot;Rank tests, k samples&quot;, &quot;Multivariate tests, part 1&quot;, &quot;Multivariate tests, part 2&quot;)
        Case Else: result = Array(&quot;None&quot;)
    End Select
    End If
     
    If Selector0 = &quot;Statistical distributions&quot; Then
    Select Case Selector1
        Case &quot;Based on elementary functions (A-K)&quot;: result = Array( _
            &quot;Arcsine&quot;, &quot;Cauchy&quot;, &quot;Dagum (Burr Type III)&quot;, &quot;Exponential&quot;, &quot;Fisk (log-logistic)&quot;, &quot;Fréchet&quot;, &quot;Generalized Extreme Value&quot;, _
            &quot;Generalized Pareto&quot;, &quot;Gompertz-Makeham&quot;, &quot;Gumbel&quot;, &quot;Hyperexponential&quot;, &quot;Kumaraswamy&quot;)
        Case &quot;Based on elementary functions (L-Z)&quot;: result = Array( _
            &quot;Laplace&quot;, &quot;Logistic&quot;, &quot;Lomax&quot;, _
            &quot;Pareto&quot;, &quot;Rayleigh&quot;, &quot;Shifted Gompertz&quot;, &quot;Singh-Maddala (Burr Type XII)&quot;, &quot;Triangular&quot;, &quot;Uniform&quot;, &quot;Weibull&quot;)
        Case &quot;Based on the error function&quot;: result = Array( _
            &quot;Birnbaum-Saunders&quot;, &quot;Exponentially Modified Gaussian&quot;, &quot;Folded normal&quot;, &quot;Half-normal&quot;, &quot;Johnson SB&quot;, &quot;Johnson SU&quot;, &quot;Lévy&quot;, _
            &quot;Lognormal (Johnson SL)&quot;, &quot;Moyal&quot;, &quot;Lognormal (Johnson SN)&quot;, &quot;Normal maximum&quot;, &quot;Normal maximum modulus&quot;, _
            &quot;Sinh-arcsinh normal&quot;, &quot;Skew normal&quot;, &quot;Truncated normal&quot;, &quot;Wald (or Inverse Gaussian)&quot;)
        Case &quot;Based on incomplete gamma&quot;: result = Array( _
            &quot;Amoroso&quot;, &quot;Chi&quot;, &quot;Chi-Squared&quot;, &quot;Log(chisquared rv)&quot;, &quot;Gamma (Pearson Type III)&quot;, &quot;Hypoexponential&quot;, &quot;Inverse chisquared&quot;, _
            &quot;Inverse Gamma (Pearson Type V)&quot;, &quot;Maxwell &quot;, &quot;Lindley (generalized)&quot;, &quot;Nakagami&quot;, &quot;Skew exponential power&quot;, _
            &quot;Stacy (generalized gamma)&quot;)
        Case &quot;Based on incomplete beta&quot;: result = Array( _
            &quot;Beta (Pearson Type I and II)&quot;, &quot;Negative Log(beta rv)&quot;, &quot;Beta-prime (Pearson Type VI)&quot;, &quot;Generalized Beta (Type 1)&quot;, _
            &quot;Generalized Beta (Type 2)&quot;, &quot;Generalized logistic&quot;, &quot;Generalized beta-exponential&quot;, &quot;Feller-Pareto&quot;, _
            &quot;Fisher F&quot;, &quot;Fisher z&quot;, &quot;Student t (Pearson Type VII)&quot;, &quot;Skew t-distribution (Jones)&quot;, &quot;Pearson’s rho (under H0)&quot;)
        Case &quot;Noncentral  (continuous)&quot;: result = Array( _
            &quot;Noncentral Chi-Squared&quot;, &quot;Noncentral Chi&quot;, &quot;Rice (Nakagami-n)&quot;, &quot;Noncentral Student t&quot;, &quot;Noncentral Pearson’s rho&quot;, _
            &quot;Noncentral Fisher F&quot;, &quot;Noncentral Beta Type I&quot;, &quot;Negative Log(noncentral beta rv)&quot;, &quot;Fisher’s R2, Type I&quot;, &quot;Log (Fisher’s 1-R2)&quot;, _
            &quot;Doubly noncentral Student t&quot;, &quot;Doubly noncentral Fisher F&quot;)
        Case &quot;Multiple comparisons of means&quot;: result = Array( _
            &quot;Normal maximum, same rho&quot;, &quot;Normal maximum modulus, same rho&quot;, &quot;Normal maximum, rho=lilj&quot;, _
            &quot;Normal maximum modulus, rho=lilj&quot;, &quot;Normal range&quot;, &quot;Studentized maximum&quot;, &quot;Studentized maximum modulus&quot;, _
            &quot;Dunnett’s t, one-sided&quot;, &quot;Dunnett’s t, two-sided&quot;, &quot;Nair’s t&quot;, &quot;Halperin’s t&quot;, &quot;Studentized range&quot;)
        Case &quot;Multivariate statistical analysis&quot;: result = Array( _
            &quot;Covariance matrix (LRT)&quot;, &quot;Mean and covariance matrix (LRT)&quot;, &quot;Product of beta rv&quot;, &quot;Log(product of beta rv)&quot;, _
            &quot;Bartlett-test (equal variances)&quot;, &quot;Wilks-test for Ip&quot;, &quot;Mauchley-test (spericity)&quot;, &quot;Wilks-test (compound symmetry)&quot;, _
            &quot;Wilks-test (k independent var groups)&quot;, &quot;Box-test (equal cov matrices, equal N)&quot;, &quot;Box-test (same mv normal, equal N)&quot;, _
             &quot;Box-test (equal cov matrices, unequal N)&quot;, &quot;Box-test (same mv normal, unequal N)&quot;, _
             &quot;Roy&apos;s largest root&quot;, &quot;Wilks Lambda&quot;, &quot;Pillai&apos;s V&quot;, &quot;Hotelling&apos;s T2&quot;, &quot;Noncentral Wilks Lambda: GLM&quot;, &quot;Noncentral Wilks Lambda: IND&quot;)
        Case &quot;Miscellaneous (continuous)&quot;: result = Array( _
            &quot;Lévy alpha-stable&quot;, &quot;Landau&quot;, &quot;Pearson Type IV&quot;, &quot;Meixner&quot;, &quot;Voigt Profile&quot;, &quot;Wrapped Cauchy&quot;, &quot;Wrapped normal&quot;, _
            &quot;Von Mises&quot;, &quot;Generalized inverse Gaussian&quot;, &quot;Harmonic&quot;, &quot;Halphen A&quot;, &quot;Halphen B &quot;, &quot;Halphen IB&quot;, &quot;Generalized hyperbolic&quot;, _
            &quot;Hyperbolic&quot;, &quot;Variance-gamma&quot;)
        Case &quot;Elementary discrete (lattice)&quot;: result = Array( _
            &quot;Geometric&quot;, &quot;Log-series&quot;, &quot;Poisson&quot;, &quot;Skellam&quot;, &quot;Binomial&quot;, &quot;Negative binomial&quot;, &quot;Delaporte&quot;, _
            &quot;Beta-Poisson (Quinkert)&quot;, &quot;Beta-binomial&quot;, &quot;Beta-negative binomial (Waring)&quot;, &quot;Classical hypergeometric&quot;, _
            &quot;Negative hypergeometric&quot;, &quot;Pólya-Eggenberger&quot;, &quot;General hypergeometric&quot;, &quot;Noncentral hypergeometric (Fisher)&quot;, _
            &quot;Zeta distribution&quot;)
        Case &quot;Discrete, related to rank tests&quot;: result = Array( _
            &quot;Wilcoxon Signed Rank&quot;, &quot;Noncentral Wilcoxon Signed Rank (Bennett)&quot;, &quot;Mann-Whitney U&quot;, _
            &quot;Noncentral Mann-Whitney U (Lehmann)&quot;, &quot;Noncentral Mann-Whitney U (Milton)&quot;, &quot;Kendall’s tau&quot;, &quot;Jonckheere-Terpsta S&quot;, _
            &quot;Generalized Page L&quot;, &quot;Noncentral Generalized Page L (Milton)&quot;)
        Case &quot;Discrete, non-lattice&quot;: result = Array( _
            &quot;Cochran-Friedman-Quade&quot;, &quot;Kruskal-Wallis&quot;)
        Case Else: result = Array(&quot;None&quot;)
    End Select
    End If

    MenuNumpy2 = result
End Function





Public Function MenuNumpy3(Selector0 As String, Selector1 As String, Selector2 As String) As Variant
    result = Array(&quot;None&quot;)
    
    
    
    If Selector0 = &quot;Numpy and related&quot; Then
    
    Select Case Selector1
        Case &quot;Array Creation&quot;
            Select Case Selector2
                Case &quot;From shape or value&quot;: result = Array( _
                    &quot;empty&quot;, &quot;eye&quot;, &quot;identity&quot;, &quot;ones&quot;, &quot;zeros&quot;, &quot;full&quot;)
                Case &quot;From existing data&quot;: result = Array( _
                    &quot;array&quot;, &quot;asarray&quot;, &quot;asanyarry&quot;, &quot;asarray_chkfinite&quot;, &quot;fromiter&quot;, &quot;fromfunction&quot;, _
                    &quot;fromstring&quot;, &quot;fromfile&quot;, &quot;loadtxt&quot;)
                Case &quot;Numerical ranges&quot;: result = Array( _
                    &quot;arange&quot;, &quot;linspace&quot;, &quot;logspace&quot;, &quot;geomspace&quot;, &quot;meshgrid&quot;, &quot;mgrid&quot;, &quot;ogrid&quot;)
                 Case &quot;Building matrices&quot;: result = Array( _
                    &quot;diag&quot;, &quot;diagonal&quot;, &quot;diagflat&quot;, &quot;tri&quot;, &quot;triu&quot;, &quot;tril&quot;, &quot;vander&quot;)
                 Case &quot;As masked array&quot;: result = Array( _
                    &quot;DataAndMask&quot;)
                 Case Else: result = Array(&quot;None&quot;)
            End Select
        
        Case &quot;Array manipulation&quot;
            Select Case Selector2
                Case &quot;Array shape&quot;: result = Array( _
                    &quot;shape&quot;, &quot;reshape&quot;, &quot;ravel&quot;, &quot;flat&quot;, &quot;flatten&quot;)
                Case &quot;Transpose-like operations&quot;: result = Array( _
                    &quot;moveaxis&quot;, &quot;rollaxis&quot;, &quot;swapaxis&quot;, &quot;transpose&quot;)
                Case &quot;Changing number of dimensions&quot;: result = Array( _
                    &quot;atleast_1d&quot;, &quot;atleast_2d&quot;, &quot;atleast_3d&quot;, &quot;broadcast&quot;, &quot;broadcasr_to&quot;, &quot;broadcast_arrays&quot;, &quot;expand_dims&quot;, &quot;squeeze&quot;)
                Case &quot;Joining arrays&quot;: result = Array( _
                    &quot;concatenate&quot;, &quot;stack&quot;, &quot;block&quot;, &quot;vstack&quot;, &quot;hstack&quot;, &quot;dstack&quot;, &quot;column_stack&quot;, &quot;tile&quot;, &quot;repeat&quot;)
                Case &quot;Splitting arrays&quot;: result = Array( _
                    &quot;split&quot;, &quot;array_split&quot;, &quot;dsplit&quot;, &quot;hsplit&quot;, &quot;vsplit&quot;)
                Case &quot;Adding and removing elements&quot;: result = Array( _
                    &quot;delete&quot;, &quot;insert&quot;, &quot;append&quot;, &quot;resize&quot;, &quot;trim_zeros&quot;, &quot;unique&quot;)
                Case &quot;Rearranging elements&quot;: result = Array( _
                    &quot;flip&quot;, &quot;fliplr&quot;, &quot;flipud&quot;, &quot;roll&quot;, &quot;rot90&quot;)
                Case &quot;Indexing-like operations&quot;: result = Array( _
                    &quot;take&quot;, &quot;take_along_axis&quot;, &quot;choose&quot;, &quot;compress&quot;, &quot;select&quot;)
                Case &quot;Inserting data into arrays&quot;: result = Array( _
                    &quot;place&quot;, &quot;put&quot;, &quot;put_along_axis&quot;, &quot;putmask&quot;, &quot;fill_diagonal&quot;)
                Case Else: result = Array(&quot;None&quot;)
            End Select
              
        Case &quot;Record Array&quot;
            Select Case Selector2
                Case &quot;Create&quot;: result = Array( _
                    &quot;Standard&quot;, &quot;From spreadsheet table&quot;, &quot;From SQLite table&quot;)
                Case &quot;Attributes&quot;: result = Array( _
                    &quot;Standard&quot;, &quot;Transposed&quot;, &quot;Real&quot;, &quot;Imag&quot;, &quot;Shape&quot;, &quot;Size&quot;)
                Case &quot;Methods (A-C)&quot;: result = Array( _
                    &quot;All&quot;, &quot;Any&quot;, &quot;Argmax&quot;, &quot;Argmin&quot;, &quot;Argpartition&quot;, &quot;Argsort&quot;, &quot;Astype&quot;, &quot;Byteswap&quot;, &quot;Chose&quot;, &quot;clip&quot;, &quot;Compress&quot;, _
                    &quot;Conj&quot;, &quot;Conjugate&quot;, &quot;Copy&quot;, &quot;Cumprod&quot;, &quot;Cumsum&quot;)
