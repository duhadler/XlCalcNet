  <Code>var a = 2.0;
var b = 0.5;
var h = 0.5;
var w = Math.Sqrt(a*a + h*h);
var su = Math.Sin(u);
var sv = Math.Sin(v);
var cu = Math.Cos(u);
var cv = Math.Cos(v);

var z = (a + b * cv)*cu + (b*h/w)*su*sv;
var y = (a + b * cv)*su - (b*h/w)*cu*sv;
var x = h*u + (b*a/w) * sv;</Code>
