<?xml version="1.0" encoding="utf-8"?>
<WpfGraphicsSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Title>Bourke SeaShell</Title>
  <Plot3DType1>Parametric surface</Plot3DType1>
  <CameraAngleTheta>114</CameraAngleTheta>
  <CameraAnglePhi>106</CameraAnglePhi>
  <CameraRadius>-1</CameraRadius>
  <CameraIsOrthographic>false</CameraIsOrthographic>
  <ShowAxes>true</ShowAxes>
  <StyleOfAxes>FullCage</StyleOfAxes>
  <AxesLabelsBackColor>false</AxesLabelsBackColor>
  <FunctionType />
  <Code>var n = 3;  // number of spirals
var a = 1;  // final shell radius
var b = 2;  // height
var c = 0.4;  // inner radius

var s = v;
var t = u;
var pt = t / (2 * Math.PI);  // inner radius

var x = a * (1 - pt) * Math.Cos(n * t) * (1 + Math.Cos(s)) + c * Math.Cos(n * t);
var z = a * (1 - pt) * Math.Sin(n * t) * (1 + Math.Cos(s)) + c * Math.Sin(n * t);
var y = b * pt + a * (1 - pt) * Math.Sin(s);
z = -z;
</Code>
  <Resolution>128</Resolution>
  <Resolution2>0</Resolution2>
  <xmin>0</xmin>
  <xmax>2 * Pi</xmax>
  <zmin>0</zmin>
  <zmax>2 * Pi</zmax>
  <RepeatStart>false</RepeatStart>
  <TransformRepeat>0</TransformRepeat>
  <XRotation>0</XRotation>
  <YRotation>0</YRotation>
  <ZRotation>0</ZRotation>
  <XTranslation>0</XTranslation>
  <YTranslation>0</YTranslation>
  <ZTranslation>0</ZTranslation>
  <ReScalingFactor>0</ReScalingFactor>
  <Truncate>0</Truncate>
  <LogLogTransform>false</LogLogTransform>
  <KeepRatios>true</KeepRatios>
  <CenteredXY>false</CenteredXY>
  <SameScale>All</SameScale>
  <ComplexType>REAL</ComplexType>
  <Branchcuts>None</Branchcuts>
  <SurfaceMaterial1>PlainColor</SurfaceMaterial1>
  <SurfaceColorString>-4128832</SurfaceColorString>
  <SurfaceColorMap1>LinearGradient0</SurfaceColorMap1>
