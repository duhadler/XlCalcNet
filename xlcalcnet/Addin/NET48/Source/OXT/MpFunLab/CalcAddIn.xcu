    <prop oor:name="DisplayName"><value xml:lang="en">asdouble</value></prop>
    <prop oor:name="Description"><value xml:lang="en">Converts the string representation of a multiple-precision number into a double.</value></prop>
    <prop oor:name="Category"><value>Add-In</value></prop>
    <prop oor:name="CompatibilityName"><value xml:lang="en">AutoAddIn.MpFunlab.asdouble</value></prop>
