  <YRotation />
  <ZRotation>1490.0 / TC</ZRotation>
  <XTranslation />
  <YTranslation>1.5</YTranslation>
  <ZTranslation />
  <FinalXRotation />
  <FinalYRotation>24</FinalYRotation>
  <Truncate>0</Truncate>
